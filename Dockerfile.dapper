FROM ubuntu:26.04

ARG GO_VERSION=1.26.5
ARG GO_SHA256_amd64=5c2c3b16caefa1d968a94c1daca04a7ca301a496d9b086e17ad77bb81393f053
ARG GO_SHA256_arm64=fe4789e92b1f33358680864bbe8704289e7bb5fc207d80623c308935bd696d49
ARG DAPPER_HOST_ARCH=amd64
ARG DOCKER_VERSION=29.4.2

ENV GOPATH=/go \
    GO111MODULE=off \
    GOCACHE=/tmp/go-build-cache \
    GOTELEMETRY=off \
    XDG_CONFIG_HOME=/tmp/go-config \
    PATH=/go/bin:/usr/local/go/bin:$PATH

RUN apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        ca-certificates \
        curl \
        default-jre \
        gcc \
        git \
        libc6-dev \
        gzip \
        make \
        python3 \
        python3-virtualenv \
        rsync \
        tar \
        tox \
        xz-utils \
        zip && \
    rm -rf /var/lib/apt/lists/* && \
    rm -f /usr/bin/pebble

RUN git config --system --add safe.directory '*'

RUN case "${DAPPER_HOST_ARCH}" in \
        amd64) go_arch=amd64; docker_arch=x86_64; go_sha="${GO_SHA256_amd64}" ;; \
        arm64) go_arch=arm64; docker_arch=aarch64; go_sha="${GO_SHA256_arm64}" ;; \
        *) echo "unsupported DAPPER_HOST_ARCH=${DAPPER_HOST_ARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/go.tgz "https://go.dev/dl/go${GO_VERSION}.linux-${go_arch}.tar.gz" && \
    echo "${go_sha}  /tmp/go.tgz" | sha256sum -c - && \
    tar -C /usr/local -xzf /tmp/go.tgz && \
    rm -f /tmp/go.tgz && \
    go version

RUN case "${DAPPER_HOST_ARCH}" in \
        amd64) docker_arch=x86_64 ;; \
        arm64) docker_arch=aarch64 ;; \
        *) echo "unsupported DAPPER_HOST_ARCH=${DAPPER_HOST_ARCH}" >&2; exit 1 ;; \
    esac && \
    curl -fsSL "https://download.docker.com/linux/static/stable/${docker_arch}/docker-${DOCKER_VERSION}.tgz" | \
        tar xzf - -C /usr/bin --strip-components=1 docker/docker && \
    chmod +x /usr/bin/docker && \
    docker --version

ENV DAPPER_SOURCE=/go/src/github.com/PastureStack/compose-cli
ENV DAPPER_OUTPUT="bin dist"
ENV DAPPER_DOCKER_SOCKET=true
ENV DAPPER_ENV="TAG REPO CROSS VERSION_OVERRIDE SKIP_INTEGRATION PLATFORM_COMPAT_JAR_URL CATTLE_JAR_URL"

WORKDIR ${DAPPER_SOURCE}
ENTRYPOINT ["./scripts/entry"]
CMD ["ci"]

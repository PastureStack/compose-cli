#!/bin/bash
set -euo pipefail

source "$(dirname "$0")/version"
cd "$(dirname "$0")/.."

if [ ! -x bin/pasturestack-compose ]; then
    ./scripts/build
fi

version="${VERSION#v}"
arch="${ARCH:-amd64}"
artifact="compose-executor-${version}-linux-${arch}.gz"
mkdir -p dist/artifacts

tmp_file="dist/artifacts/${artifact}.tmp"
rm -f "${tmp_file}"
gzip -n -9 -c bin/pasturestack-compose >"${tmp_file}"
mv "${tmp_file}" "dist/artifacts/${artifact}"
sha256sum "dist/artifacts/${artifact}"
